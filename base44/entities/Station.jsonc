{
  "name": "Station",
  "type": "object",
  "properties": {
    "merchant_id": {
      "type": "string",
      "description": "Merchant ID - REQUIRED"
    },
    "station_id": {
      "type": "string",
      "description": "URL-safe station slug used in display links (e.g. counter-1, bar, server-3)"
    },
    "name": {
      "type": "string",
      "description": "Display name (e.g. Counter 1, Bar, Server Station)"
    },
    "layout_type": {
      "type": "string",
      "enum": [
        "counter",
        "server",
        "bar",
        "kitchen",
        "generic"
      ],
      "default": "generic",
      "description": "Station layout/type"
    },
    "receipt_printer_id": {
      "type": "string",
      "description": "Printer ID (from MerchantSettings.hardware_devices.printers) used for receipt printing at this station. Null = use merchant default."
    },
    "kitchen_printer_id": {
      "type": "string",
      "description": "Printer ID used for kitchen ticket printing at this station. Null = use merchant default."
    },
    "bar_printer_id": {
      "type": "string",
      "description": "Printer ID used for bar ticket printing at this station. Null = use merchant default."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this station is active"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "mobile_access_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether mobile POS / Customer Display access is enabled for this station"
    },
    "mobile_station_token": {
      "type": "string",
      "description": "Secure random token used in the public mobile POS URL. Never expose the station's internal database ID."
    },
    "mobile_token_created_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the mobile token was created"
    },
    "mobile_token_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the mobile token expires (null = no expiration)"
    },
    "mobile_pin_hash": {
      "type": "string",
      "description": "SHA-256 hash of the station PIN. Never store plain-text PINs."
    },
    "allow_mobile_cashier_controls": {
      "type": "boolean",
      "default": false,
      "description": "Whether mobile devices can access cashier controls (requires employee auth or station PIN)"
    },
    "customer_display_id": {
      "type": "string",
      "description": "Assigned Customer Display configuration/layout ID"
    },
    "mobile_display_timeout": {
      "type": "number",
      "default": 8,
      "description": "Seconds to show the approved/declined screen before returning to idle"
    },
    "max_mobile_connections": {
      "type": "number",
      "default": 3,
      "description": "Maximum number of simultaneous mobile display connections"
    },
    "last_mobile_connection_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last time a mobile device connected to this station"
    }
  },
  "required": [
    "merchant_id",
    "station_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.merchant_id": "{{user.data.merchant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.merchant_id": "{{user.data.merchant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.merchant_id": "{{user.data.merchant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.merchant_id": "{{user.data.merchant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}