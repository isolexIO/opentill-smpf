{
  "name": "Advertisement",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description for search visibility and SEO (up to 1000 characters)",
      "maxLength": 1000
    },
    "title": {
      "type": "string",
      "description": "Ad title/name for admin reference"
    },
    "type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "html"
      ],
      "description": "Type of ad content"
    },
    "content_url": {
      "type": "string",
      "description": "URL to image/video, or HTML content"
    },
    "link_url": {
      "type": "string",
      "description": "Click destination URL (optional)"
    },
    "duration_seconds": {
      "type": "number",
      "default": 10,
      "description": "How long to display this ad in rotation"
    },
    "display_order": {
      "type": "number",
      "default": 0,
      "description": "Order in rotation (lower = first)"
    },
    "priority": {
      "type": "number",
      "default": 0,
      "description": "Higher priority ads are shown first"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether ad is currently active"
    },
    "target_location": {
      "type": "string",
      "enum": [
        "system_menu",
        "customer_display",
        "both"
      ],
      "default": "system_menu",
      "description": "Where this ad should appear"
    },
    "schedule_start": {
      "type": "string",
      "format": "date-time",
      "description": "When to start showing this ad (optional)"
    },
    "schedule_end": {
      "type": "string",
      "format": "date-time",
      "description": "When to stop showing this ad (optional)"
    },
    "days_of_week": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 6
      },
      "default": [],
      "description": "Days of week to show (0=Sun..6=Sat). Empty = all days."
    },
    "start_time_of_day": {
      "type": "string",
      "description": "HH:MM local time to start showing daily (optional). Empty = no start restriction."
    },
    "end_time_of_day": {
      "type": "string",
      "description": "HH:MM local time to stop showing daily (optional). Empty = no end restriction."
    },
    "max_views_per_day": {
      "type": "number",
      "default": 0,
      "description": "Maximum times shown per device per day (0 = unlimited)"
    },
    "max_views_per_session": {
      "type": "number",
      "default": 0,
      "description": "Maximum times shown per browser session (0 = unlimited)"
    },
    "target_merchant_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Restrict to these merchant IDs. Empty = all merchants."
    },
    "target_dealer_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Restrict to these dealer/ambassador IDs. Empty = all dealers."
    },
    "click_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times ad was clicked"
    },
    "view_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times ad was viewed"
    },
    "created_by": {
      "type": "string",
      "description": "Admin user who created the ad"
    }
  },
  "required": [
    "title",
    "type",
    "content_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "data.is_active": {
        "$in": [
          true,
          false,
          null
        ]
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}