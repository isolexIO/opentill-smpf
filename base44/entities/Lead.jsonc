{
  "name": "Lead",
  "type": "object",
  "properties": {
    "dealer_id": {
      "type": "string",
      "description": "Ambassador/dealer ID that owns this lead"
    },
    "business_name": {
      "type": "string",
      "description": "Prospect business name"
    },
    "contact_name": {
      "type": "string",
      "description": "Primary contact person name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Contact email address"
    },
    "phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "qualified",
        "proposal_sent",
        "converted",
        "lost"
      ],
      "default": "new",
      "description": "Lead pipeline status"
    },
    "source": {
      "type": "string",
      "enum": [
        "referral",
        "website",
        "social_media",
        "email_campaign",
        "phone_call",
        "walk_in",
        "other"
      ],
      "default": "referral",
      "description": "How the lead was acquired"
    },
    "business_type": {
      "type": "string",
      "enum": [
        "restaurant",
        "retail",
        "grocery",
        "cafe",
        "bar",
        "other"
      ],
      "default": "other",
      "description": "Type of business the prospect operates"
    },
    "estimated_value": {
      "type": "number",
      "default": 0,
      "description": "Estimated monthly revenue or deal value in USD"
    },
    "notes": {
      "type": "string",
      "description": "Free-form notes about the lead"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Custom tags for categorizing leads"
    },
    "list_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs of LeadList records this lead belongs to"
    },
    "import_source": {
      "type": "string",
      "description": "Where the lead was imported from (e.g. 'vtiger', 'csv', 'hubspot', 'manual')"
    },
    "external_id": {
      "type": "string",
      "description": "External CRM record ID, used to deduplicate on re-import"
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "note",
              "email",
              "call",
              "status_change",
              "appointment",
              "meeting"
            ],
            "description": "Type of activity"
          },
          "text": {
            "type": "string",
            "description": "Activity content"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "author": {
            "type": "string",
            "description": "Who performed the activity"
          }
        }
      },
      "default": [],
      "description": "Activity log / notes timeline"
    },
    "appointments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "time": {
            "type": "string"
          },
          "duration_minutes": {
            "type": "number",
            "default": 30
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "completed",
              "cancelled"
            ],
            "default": "scheduled"
          },
          "notes": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "Scheduled appointments for this lead"
    },
    "last_contacted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the lead was last contacted"
    },
    "next_follow_up": {
      "type": "string",
      "format": "date-time",
      "description": "Scheduled follow-up date"
    },
    "converted_merchant_id": {
      "type": "string",
      "description": "Merchant ID if the lead converted to a merchant"
    },
    "converted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the lead was converted"
    }
  },
  "required": [
    "dealer_id",
    "business_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.dealer_id": "{{user.data.dealer_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.dealer_id": "{{user.data.dealer_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.dealer_id": "{{user.data.dealer_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.dealer_id": "{{user.data.dealer_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}