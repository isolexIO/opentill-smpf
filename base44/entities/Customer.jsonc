{
  "name": "Customer",
  "type": "object",
  "properties": {
    "dealer_id": {
      "type": "string",
      "description": "Dealer ID for multi-tenant isolation"
    },
    "merchant_id": {
      "type": "string",
      "description": "Merchant ID for per-merchant customer records. Null for global customers (usable at all merchants with rewards activated)."
    },
    "name": {
      "type": "string",
      "description": "Customer full name"
    },
    "email": {
      "type": "string",
      "description": "Customer email"
    },
    "phone": {
      "type": "string",
      "description": "Customer phone number"
    },
    "loyalty_points": {
      "type": "number",
      "default": 0,
      "description": "Current loyalty points balance"
    },
    "duc_balance": {
      "type": "number",
      "default": 0,
      "description": "$DUC token balance earned via merchant loyalty rewards"
    },
    "duc_lifetime_earned": {
      "type": "number",
      "default": 0,
      "description": "Total $DUC ever earned by this customer from this merchant"
    },
    "total_spent": {
      "type": "number",
      "default": 0,
      "description": "Lifetime total spent"
    },
    "visit_count": {
      "type": "number",
      "default": 0,
      "description": "Number of visits"
    },
    "preferred_payment": {
      "type": "string",
      "enum": [
        "cash",
        "card",
        "crypto",
        "mobile"
      ],
      "description": "Preferred payment method"
    },
    "notes": {
      "type": "string",
      "description": "Customer notes or preferences"
    },
    "pin_hash": {
      "type": "string",
      "description": "SHA-256 hash of the customer's portal PIN"
    },
    "last_portal_login": {
      "type": "string",
      "format": "date-time",
      "description": "When the customer last logged into the portal"
    },
    "referral_code": {
      "type": "string",
      "description": "This customer's personal referral code. Used in brochure/signup links so referrals are credited to the customer (not the merchant)."
    },
    "ref_clicks": {
      "type": "number",
      "default": 0,
      "description": "Number of times this customer's referral link was clicked"
    },
    "ref_shares": {
      "type": "number",
      "default": 0,
      "description": "Number of times this customer shared their referral link"
    },
    "ref_conversions": {
      "type": "number",
      "default": 0,
      "description": "Number of merchants referred by this customer that hit the processing threshold and earned the customer $DUC"
    },
    "ref_duc_earned": {
      "type": "number",
      "default": 0,
      "description": "Total $DUC earned by this customer from referral conversions"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.merchant_id": "{{user.data.merchant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.merchant_id": "{{user.data.merchant_id}}"
        },
        {
          "data.dealer_id": "{{user.data.dealer_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.merchant_id": "{{user.data.merchant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}