{
  "name": "Location",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description for search visibility and SEO (up to 1000 characters)",
      "maxLength": 1000
    },
    "merchant_id": {
      "type": "string",
      "description": "Merchant that owns this location - REQUIRED"
    },
    "dealer_id": {
      "type": "string",
      "description": "Dealer ID for multi-tenant isolation"
    },
    "name": {
      "type": "string",
      "description": "Location display name (e.g. Downtown, Store #2)"
    },
    "catalog_mode": {
      "type": "string",
      "enum": [
        "shared",
        "standalone"
      ],
      "default": "shared",
      "description": "shared = use the merchant's shared product catalog; standalone = this location has its own product catalog (products tagged with this location_id)"
    },
    "address": {
      "type": "string",
      "description": "Full street address of this location, used for GPS auto-selection via geocoding"
    },
    "latitude": {
      "type": "number",
      "description": "Geocoded latitude of the street address. Used by the POS to auto-select the nearest location based on the device's GPS position."
    },
    "longitude": {
      "type": "number",
      "description": "Geocoded longitude of the street address. Used by the POS to auto-select the nearest location based on the device's GPS position."
    },
    "phone": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this location is active"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "The default location for the merchant (used when no location is selected)"
    },
    "settings_override": {
      "type": "object",
      "description": "Per-location overrides for merchant settings",
      "properties": {
        "timezone": {
          "type": "string"
        },
        "tax_rate": {
          "type": "number"
        },
        "currency": {
          "type": "string"
        }
      }
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "merchant_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.merchant_id": "{{user.data.merchant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.merchant_id": "{{user.data.merchant_id}}"
        },
        {
          "data.dealer_id": "{{user.data.dealer_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.merchant_id": "{{user.data.merchant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.merchant_id": "{{user.data.merchant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}