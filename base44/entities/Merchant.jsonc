{
  "name": "Merchant",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Optional description for search visibility and SEO (up to 1000 characters)",
      "maxLength": 1000
    },
    "dealer_id": {
      "type": "string",
      "description": "Parent dealer/reseller ID - REQUIRED for multi-tenant isolation"
    },
    "business_name": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "owner_email": {
      "type": "string",
      "format": "email"
    },
    "google_email": {
      "type": "string",
      "description": "Google account email linked to this merchant (verified via Google OAuth). Allows Google login even when it differs from owner_email."
    },
    "owner_name": {
      "type": "string"
    },
    "admin_pin": {
      "type": "string",
      "description": "Initial admin PIN for quick POS login (set at activation, before the user accepts their platform invite)"
    },
    "temp_password": {
      "type": "string",
      "description": "Bcrypt hash of the temporary or reset password for email login. Cleared after first successful login (set by activateMerchant or resetUserPassword)."
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "tax_id": {
      "type": "string"
    },
    "referral_code": {
      "type": "string",
      "description": "Unique referral code for this merchant"
    },
    "referred_by_code": {
      "type": "string",
      "description": "Referral code that was used when signing up"
    },
    "status": {
      "type": "string",
      "enum": [
        "inactive",
        "active",
        "suspended",
        "trial",
        "cancelled"
      ],
      "default": "inactive"
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "Demo accounts have full access with no fees"
    },
    "duc_stake_required": {
      "type": "boolean",
      "default": true,
      "description": "Whether this merchant is required to stake $DUC to use the platform"
    },
    "duc_stake_amount": {
      "type": "number",
      "default": 50000,
      "description": "Required $DUC stake amount for this merchant"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "suspended_at": {
      "type": "string",
      "format": "date-time"
    },
    "suspension_reason": {
      "type": "string"
    },
    "total_revenue": {
      "type": "number",
      "default": 0
    },
    "total_orders": {
      "type": "number",
      "default": 0
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "features_enabled": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "pos",
        "inventory",
        "reports"
      ]
    },
    "opentill_subdomain": {
      "type": "string",
      "description": "Auto-assigned DNS subdomain label (mybrand.openTILL.io)"
    },
    "subdomain_status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "disabled"
      ],
      "default": "pending",
      "description": "DNS subdomain activation status"
    },
    "subdomain_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "When DNS subdomain was requested"
    },
    "subdomain_approved_at": {
      "type": "string",
      "format": "date-time",
      "description": "When DNS subdomain was approved"
    },
    "subdomain_wallet": {
      "type": "string",
      "description": "Wallet address linked to subdomain"
    },
    "sns_subdomain": {
      "type": "string",
      "description": "Optional on-chain SNS subdomain label (mybrand.opentill.sol). Separate from the auto DNS opentill_subdomain."
    },
    "sns_subdomain_status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "disabled"
      ],
      "default": "pending",
      "description": "On-chain SNS subdomain mint status"
    },
    "sns_subdomain_wallet": {
      "type": "string",
      "description": "Wallet that owns the minted SNS subdomain"
    },
    "settings": {
      "type": "object",
      "properties": {
        "timezone": {
          "type": "string",
          "default": "America/New_York"
        },
        "currency": {
          "type": "string",
          "default": "USD"
        },
        "tax_rate": {
          "type": "number",
          "default": 0.08
        },
        "enable_opentill_payments": {
          "type": "boolean",
          "default": false
        },
        "multi_location": {
          "type": "object",
          "description": "Multi-location configuration for this merchant",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "Whether multi-location support is turned on for this merchant"
            },
            "default_catalog_mode": {
              "type": "string",
              "enum": [
                "shared",
                "standalone"
              ],
              "default": "shared",
              "description": "Default catalog mode for new locations"
            }
          }
        },
        "pricing_and_surcharge": {
          "type": "object",
          "properties": {
            "enable_dual_pricing": {
              "type": "boolean",
              "default": false
            },
            "cc_surcharge_percent": {
              "type": "number",
              "default": 3.5
            },
            "flat_fee_amount": {
              "type": "number",
              "default": 0
            },
            "apply_flat_fee_to_all": {
              "type": "boolean",
              "default": false
            },
            "show_dual_prices": {
              "type": "boolean",
              "default": true
            },
            "region": {
              "type": "string",
              "enum": [
                "US",
                "CA",
                "Other"
              ],
              "default": "US"
            },
            "pricing_mode": {
              "type": "string",
              "enum": [
                "surcharge",
                "cash_discount"
              ],
              "default": "surcharge"
            },
            "sync_with_payments": {
              "type": "boolean",
              "default": false,
              "description": "When true, the surcharge auto-matches the openTILL Payments (Stripe) processing rate plus the platform fee instead of using the manually configured percentage"
            }
          }
        },
        "payment_gateways": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "stripe": {
              "type": "object",
              "properties": {
                "processing_rate_percent": {
                  "type": "number",
                  "default": 2.9,
                  "description": "The actual processing rate (%) charged to the merchant by openTILL Payments (Stripe). Used for dual-pricing sync."
                },
                "processing_flat_fee": {
                  "type": "number",
                  "default": 0.3,
                  "description": "The flat per-transaction fee ($) charged by openTILL Payments (Stripe). Used for dual-pricing sync."
                },
                "platform_fee_percent": {
                  "type": "number",
                  "default": 0.5,
                  "description": "The openTILL platform fee (%) charged per transaction on top of the Stripe processing fee. Included in dual-pricing sync so the merchant recovers both fees."
                }
              }
            }
          }
        },
        "solana_pay": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "network": {
              "type": "string",
              "enum": [
                "mainnet",
                "devnet"
              ],
              "default": "mainnet"
            },
            "wallet_address": {
              "type": "string"
            },
            "accepted_token": {
              "type": "string",
              "default": "USDC"
            },
            "custom_token_mint": {
              "type": "string"
            },
            "custom_token_symbol": {
              "type": "string"
            },
            "custom_token_decimals": {
              "type": "number",
              "default": 6
            },
            "display_in_customer_terminal": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "customer_display": {
          "type": "object",
          "additionalProperties": true
        },
        "age_verification": {
          "type": "object",
          "additionalProperties": true
        },
        "kitchen_display": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "auto_print": {
              "type": "boolean",
              "default": false
            },
            "group_by_station": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "online_ordering": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "allow_cash_payment": {
              "type": "boolean",
              "default": true
            },
            "allow_pickup": {
              "type": "boolean",
              "default": true
            },
            "allow_delivery": {
              "type": "boolean",
              "default": true
            },
            "min_order_amount": {
              "type": "number",
              "default": 0
            },
            "delivery_fee": {
              "type": "number",
              "default": 0
            },
            "delivery_radius_miles": {
              "type": "number",
              "default": 10
            }
          }
        },
        "hardware": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "required": [
    "business_name",
    "owner_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.dealer_id": "{{user.data.dealer_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.merchant_id}}"
        },
        {
          "data.dealer_id": "{{user.data.dealer_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "id": "{{user.data.merchant_id}}"
        },
        {
          "data.dealer_id": "{{user.data.dealer_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}