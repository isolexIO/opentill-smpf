{
  "name": "Daily Builder Payout Processing",
  "description": "Daily job that schedules due BuilderPayouts (hold period elapsed) and processes them via $DUC (Solana) transfer to the builder's wallet.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "15 5 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_builder_payout_processing",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processBuilderPayouts",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}