{
  "name": "Referral Reward Distribution",
  "description": "Automatically distributes referral rewards when referred merchants earn $cLINK",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "cLINKReward"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "referral_reward_distribution",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processReferralReward",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "processReferralReward"
  }
}