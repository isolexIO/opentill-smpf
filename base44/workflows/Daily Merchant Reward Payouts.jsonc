{
  "name": "Daily Merchant Reward Payouts",
  "description": "Daily job that automatically pays out available $DUC merchant rewards (cLINKReward) to each merchant's configured Solana wallet, above the minimum claim threshold.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "30 5 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_merchant_reward_payouts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processMerchantRewardPayouts",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}